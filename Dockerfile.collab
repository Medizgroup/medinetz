# Collab-Server (Yjs/Hocuspocus) als eigener, dauerhaft laufender Prozess.
# Siehe DEPLOYMENT.md — dieser Container braucht dieselbe DATABASE_URL und
# denselben BETTER_AUTH_SECRET wie die Next.js-App, sonst schlägt jede
# Collab-Verbindung mit "Nicht autorisiert" fehl.

FROM node:24-alpine

WORKDIR /app

# Version an das lokal genutzte pnpm angleichen (siehe pnpm -v) — sonst
# interpretiert eine ältere pnpm-Version pnpm-workspace.yaml falsch, weil
# `allowBuilds` erst in neueren pnpm-Releases unterstützt wird.
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=production
EXPOSE 1234

CMD ["pnpm", "exec", "tsx", "collab-server/index.ts"]
