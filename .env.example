# ─── Medinetz — Konfiguration ───────────────────────────────────────────────
# Für den Server: nach .env kopieren und ausfüllen (docker compose liest sie).
# Für die Entwicklung: zusätzlich DATABASE_URL setzen (siehe unten).

# Domain, unter der die App erreichbar ist (DNS A-Record auf den Server).
# Caddy holt dafür automatisch ein HTTPS-Zertifikat.
DOMAIN=medinetz.example.org

# Name/Untertitel, die in der App angezeigt werden.
INSTITUT_NAME="Medinetz Beispielstadt"
INSTITUT_SUBTITLE="Dein digitaler Medinetz-Arbeitsplatz"

# Datenbank-Passwort (beliebig, lang und zufällig): openssl rand -hex 24
POSTGRES_PASSWORD=

# Schlüssel für Logins und Collab-Tickets: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional: fertiges Image aus einer Registry statt lokal zu bauen,
# z.B. ghcr.io/medizgroup/medinetz (siehe DEPLOYMENT.md)
# MEDINETZ_IMAGE=

# Optional: Feintuning für kleine Server
# DATABASE_POOL_MAX=5
# NODE_MAX_MEMORY_MB=384

# ─── Nur für die lokale Entwicklung (pnpm dev) ──────────────────────────────
# DATABASE_URL=postgresql://medinetz:medinetz@localhost:5432/medinetz
# BETTER_AUTH_URL=http://localhost:3000
# Separater Collab-Server aus `pnpm collab-server`:
# NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
